# Public, HTTPS URL mapped to public/social-content in this repository.
PUBLIC_ASSET_BASE_URL=https://www.phaminh.com/social-content

# Safe default. Change to true only after both social accounts are connected.
PUBLISH_ENABLED=false
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
TIMEZONE=America/Los_Angeles
