RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Force www (non-www → www)
RewriteCond %{HTTP_HOST} ^phaminh\.com$ [NC]
RewriteRule ^ https://www.phaminh.com%{REQUEST_URI} [R=301,L]

# React Router — serve index.html for all non-file routes
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# ── Long cache lifetimes for static assets (saves bandwidth on repeat visits) ──
<IfModule mod_expires.c>
  ExpiresActive On
  # Images, video, fonts — 1 year (filename hashing handles cache busting for JS/CSS)
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/svg+xml     "access plus 1 year"
  ExpiresByType image/x-icon      "access plus 1 year"
  ExpiresByType video/mp4         "access plus 1 year"
  ExpiresByType font/woff2        "access plus 1 year"
  ExpiresByType font/woff         "access plus 1 year"
  # Hashed JS/CSS — 1 year (filename changes on update)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css          "access plus 1 year"
  # HTML — short cache so users see updates
  ExpiresByType text/html         "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # HSTS — force HTTPS for 1 year, include subdomains
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Cache-Control for static assets (immutable, since filenames are hashed)
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
