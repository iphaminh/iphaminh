RewriteEngine On
RewriteBase /

# Every prerendered route is a directory; without this, mod_dir 301s each
# slash-less URL to its slashed twin while the page's canonical says slash-less
# — the contradiction behind the 2026-08 Search Console "alternate canonical"
# and "page with redirect" buckets. If the host ever 500s on this directive,
# delete this line (rule 4 below still serves the right file without it).
DirectorySlash Off

# 1) Canonical scheme + host in ONE 301 (http and/or bare host → https://www)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.phaminh\.com$ [NC]
RewriteRule ^ https://www.phaminh.com%{REQUEST_URI} [R=301,L]

# 2) Legacy paths — real server-side 301s. The first three mirror the
#    client-side <Navigate> redirects in src/App.js; /wedding is a retired
#    URL Google indexed while the SPA fallback served it as a soft 200.
RewriteRule ^testimonial$ /testimonials [R=301,L]
RewriteRule ^foto/couples$ /foto/engagement [R=301,L]
RewriteRule ^foto/portraits$ /foto/portrait [R=301,L]
RewriteRule ^wedding$ /foto [R=301,L]

# 3) Strip trailing slashes — canonical form is slash-less
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 4) Serve prerendered directory indexes internally (no redirect).
#    ^(.+)$ leaves the root '/' untouched — DirectoryIndex still serves it.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ /$1/index.html [L]

# 5) Real 404s. Safe to drop the old SPA catch-all because every legitimate
#    route is a prerendered physical file — anything else SHOULD 404 instead
#    of soft-200ing the homepage (which got /wedding wrongly indexed).
ErrorDocument 404 /404.html

# ── Long cache lifetimes for static assets (saves bandwidth on repeat visits) ──
<IfModule mod_expires.c>
  ExpiresActive On
  # Images, video, fonts — 1 year (filename hashing handles cache busting for JS/CSS)
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/svg+xml     "access plus 1 year"
  ExpiresByType image/x-icon      "access plus 1 year"
  ExpiresByType video/mp4         "access plus 1 year"
  ExpiresByType font/woff2        "access plus 1 year"
  ExpiresByType font/woff         "access plus 1 year"
  # Hashed JS/CSS — 1 year (filename changes on update)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css          "access plus 1 year"
  # HTML — short cache so users see updates
  ExpiresByType text/html         "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # HSTS — force HTTPS for 1 year, include subdomains
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Cache-Control for static assets (immutable, since filenames are hashed)
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
